# ============================================================
# Binance / 币安
# ============================================================

# 域名后缀
DOMAIN-SUFFIX,binance.com
DOMAIN-SUFFIX,binance.info
DOMAIN-SUFFIX,binance.org

# Spot REST API
DOMAIN,api.binance.com
DOMAIN,api1.binance.com
DOMAIN,api2.binance.com
DOMAIN,api3.binance.com
DOMAIN,api4.binance.com

# Spot WebSocket
DOMAIN,stream.binance.com
DOMAIN,ws-api.binance.com

# Futures REST
DOMAIN,fapi.binance.com
DOMAIN,dapi.binance.com

# Futures WebSocket / Market Data
DOMAIN,fstream.binance.com
DOMAIN,data-stream.binance.com
DOMAIN,data.binance.com


